# ==============================================================================
# TRML QMAX_PAMUNGKAS (SYN3_RISK_PARITY) - 15m MULTI-REGIME GROWTH CHAMPION
# ==============================================================================
# Locked after 4-phase Q-MAX R&D (34m 2024-01..2026-10, 15m, Start $125 Comp.)
# Comp.: $1,110.74 (+788.6%, CAGR 116.4%), Net PF 1.54, MTM DD 15.93%, Sh 2.21, Cal 7.30
# 100% MARKET Stress: $718.94 (+475.2%), Net PF 1.40, MTM DD 19.41%, 0 Liquidations

# Modal Awal & Mode Ekuitas (sesuaikan EQUITY_MODE_COMPOUNDING untuk live/dry-run)
INITIAL_EQUITY=125.0
EQUITY_MODE_COMPOUNDING=true

# Parameter Biaya & Friction Pesimistis
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002
FLAG_SL_GAP_FILL=true
FLAG_DEDUCT_PENDING_MARGIN=true

# Parameter Manajemen Risiko & Ukuran Posisi
ACCOUNT_LEVERAGE=10.0
RISK_PER_TRADE_PCT=0.02125
MAX_CONCURRENT_SLOTS=6
MAX_SLOT_MARGIN_FRACTION=0.22
MAX_MARGIN_AVAIL_FRAC=0.90
MAX_DAILY_DRAWDOWN_PCT=-0.075

# Tipe Order Entry
ENTRY_ORDER_TYPE=LIMIT
ENTRY_REPEG_MAX_ATTEMPTS=0

# Parameter Dynamic Rolling Market Scanner (15m / 30m scan)
MIN_VOLUME_24H_USDT=15000000.0
MAX_SPREAD_PCT=0.11
MIN_FALLBACK_RVOL=0.50
MIN_NATR_PCT=0.95
MAX_NATR_PCT=1.60
MAX_SCANNER_VWAP_DIST_ATR=2.50
MAX_WATCHED_COINS=100
SCANNER_RANKING_MODE=pullback
SCANNER_EXCLUDE_TOP_VOL_RANK=15

# Strategi 1: VWAP Pullback / Retest with Orderflow Bounce
VWAP_STRATEGY_ENABLED=true
PULLBACK_TOLERANCE_ATR=0.38
MIN_BOUNCE_ZSCORE=0.65
MIN_BOUNCE_ZSCORE_LONG=0.60
MIN_BOUNCE_ZSCORE_SHORT=0.70
MIN_EMA200_DISTANCE_ATR=0.20
MAX_EMA200_DISTANCE_ATR=3.80
LOOKBACK_IMPULSE_BARS=12
RETEST_LOOKBACK_BARS=4
MIN_IMPULSE_ATR=0.75
MAX_ENTRY_DISTANCE_ATR=1.20

# Strategi 2: Vol Compression Donchian Breakout (Prioritas #1 di Trend Regime)
BREAKOUT_STRATEGY_ENABLED=true
BREAKOUT_PRIORITY_FIRST=true
BREAKOUT_LOOKBACK_BARS=16
BREAKOUT_MAX_COMPRESSION=0.90
BREAKOUT_MIN_RVOL=1.40
BREAKOUT_MIN_BODY_RATIO=0.45
BREAKOUT_MIN_DELTA_Z=0.50

# Strategi Lain (Disabled — Terbukti Lemah Multi-Regime)
SWEEP_STRATEGY_ENABLED=false
SWEEP_LOOKBACK_BARS=12
SWEEP_MIN_UPPER_WICK_RATIO=0.25
SWEEP_MAX_LOWER_WICK_RATIO=0.45
SWEEP_MAX_DELTA_ZSCORE=-0.25
SWEEP_SCANNER_ALLOW_EXTENDED_VWAP=false
SWEEP_SCANNER_MAX_EXTRA_COINS=15
REL_STRATEGY_ENABLED=false

# Exit Ladder & Time Stop
SL_ATR_MULTIPLIER=2.00
TP_ATR_MULTIPLIER=5.00
MIN_SL_DISTANCE_PCT=0.0150
PARTIAL_TP_ENABLED=false
PARTIAL_TP1_RATIO=0.35
PARTIAL_TP1_ATR_MULT=1.25
TIER1_BE_ENABLED=false
TIER1_BE_TRIGGER_LONG_ATR=1.05
TIER1_BE_TRIGGER_SHORT_ATR=0.85
RUNNER_BE_CUSHION_ATR=0.0
TRAILING_ENABLED=true
TRAILING_ACTIVATE_ATR=2.50
TRAILING_DISTANCE_ATR=1.00
STALE_LOSS_EXIT_DURATION=6h
MAX_HOLDING_DURATION=18h

# Filter OI (QMAX_PAMUNGKAS menonaktifkan filter OI secara eksplisit agar selaras dengan live)
DISABLE_OI_FILTER=true
MIN_OI_DELTA_LONG_PCT=-0.50
MIN_OI_DELTA_SHORT_PCT=-1.00

# Filter Makro BTC, HTF 1h EMA200 & Multi-Regime Router
TIMEFRAME=15m
SCANNER_INTERVAL=15m
LIMIT_ORDER_TIMEOUT=30m
ALLOWED_SIDE=SHORT_ONLY
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=1.15
BTC_MAX_5M_PUMP_PCT=1.15
BTC_GATE_PERSISTENCE_BARS=1
FLAG_BTC_GATE_SHORT_ONLY=true
BTC_COUNTER_MOMENTUM_PCT=0.30
MAX_FRENZY_RVOL=2.50
MIN_SIGNAL_RVOL=0.0
BTC_CHOP_BLOCK_LONG=true
BTC_CHOP_BLOCK_SHORT=true
BTC_CHOP_RISK_MULT=1.0
MIN_EMA_SLOPE_LONG=0.008
MIN_CANDLE_BODY_RATIO_LONG=0.25
MIN_NATR_LONG_PCT=1.05
DISABLE_PANIC_DUMP_FRENZY_LONG=true
BLOCKED_UTC_HOURS=
