# ==============================================================================
# TRML STANDALONE BACKTEST ENGINE CONFIGURATION - OPTION A (QUALITY SHORT CHAMPION)
# ==============================================================================
# Konfigurasi hasil optimasi 6 bulan (1 Mei 2026 - 31 Oktober 2026)
# Metrik Uji Empiris: 811 Trades | Win Rate 58.20% | Profit Factor 1.20
# Net PnL: +$40.32 USDT (+32.25%) | Max Drawdown: -19.65% | Expectancy: +$0.05/tr

# Modal Awal Simulasi Backtest (USDT)
INITIAL_EQUITY=125.0
EQUITY_MODE_COMPOUNDING=false

# Parameter Biaya & Friction Pesimistis
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002

# Parameter Manajemen Risiko & Ukuran Posisi
ACCOUNT_LEVERAGE=8.0
RISK_PER_TRADE_PCT=0.015
MAX_CONCURRENT_SLOTS=10
MAX_SLOT_MARGIN_FRACTION=0.15
MAX_MARGIN_AVAIL_FRAC=0.90
MAX_DAILY_DRAWDOWN_PCT=-0.05

# Tipe Order Entry: "LIMIT" atau "MARKET"
ENTRY_ORDER_TYPE=LIMIT

# Parameter Dynamic Rolling Market Scanner (Setiap 15 Menit)
MIN_VOLUME_24H_USDT=15000000.0
MAX_SPREAD_PCT=0.05
MIN_FALLBACK_RVOL=0.50
MIN_NATR_PCT=0.65
MAX_NATR_PCT=1.20
MAX_SCANNER_VWAP_DIST_ATR=2.50
MAX_WATCHED_COINS=50
SCANNER_RANKING_MODE=pullback

# Parameter Strategi VWAP Pullback / Retest with Orderflow Bounce
PULLBACK_TOLERANCE_ATR=0.38
MIN_BOUNCE_ZSCORE=0.75
MIN_BOUNCE_ZSCORE_LONG=1.20
MIN_BOUNCE_ZSCORE_SHORT=0.70
MIN_EMA200_DISTANCE_ATR=0.20
MAX_EMA200_DISTANCE_ATR=3.80
LOOKBACK_IMPULSE_BARS=18
RETEST_LOOKBACK_BARS=5
MIN_IMPULSE_ATR=0.62
MAX_ENTRY_DISTANCE_ATR=1.20

# Multiplier Stop Loss & Take Profit (ATR-based)
SL_ATR_MULTIPLIER=1.65
TP_ATR_MULTIPLIER=3.60
MIN_SL_DISTANCE_PCT=0.0100

# Partial Take Profit & Trailing Stop
PARTIAL_TP_ENABLED=true
PARTIAL_TP1_RATIO=0.35
PARTIAL_TP1_ATR_MULT=1.25
RUNNER_BE_CUSHION_ATR=0.0
TRAILING_ENABLED=true
TRAILING_ACTIVATE_ATR=1.50
TRAILING_DISTANCE_ATR=0.35

# Filter Makro BTC & Anti-Frenzy
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=0.65
BTC_MAX_5M_PUMP_PCT=0.65
BTC_GATE_PERSISTENCE_BARS=1
FLAG_BTC_GATE_SHORT_ONLY=true
BTC_COUNTER_MOMENTUM_PCT=0.15
ALLOWED_SIDE=SHORT_ONLY
MAX_FRENZY_RVOL=2.50
MIN_SIGNAL_RVOL=0.0

# Cooldown & Warmup Guard
COOLDOWN_AFTER_EXIT_MINUTES=4
COOLDOWN_AFTER_LOSS_MINUTES=12
COOLDOWN_AFTER_WIN_MINUTES=2
VWAP_SESSION_WARMUP_MINUTES=20
MAX_HOLDING_DURATION=3h
