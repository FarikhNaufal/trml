MAJOR_POD_TP_ATR_MULTIPLIER=6.0
MAJOR_POD_MIN_SL_DISTANCE_PCT=0.0100
MAJOR_POD_TRAILING_ENABLED=true
MAJOR_POD_TRAILING_ACTIVATE_ATR=2.5
