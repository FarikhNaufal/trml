# ==============================================================================
# TRML STANDALONE BACKTEST ENGINE CONFIGURATION - MODEL 2.5 (HYBRID ASYMMETRIC)
# ==============================================================================
# Modal Awal Simulasi Backtest (USDT)
INITIAL_EQUITY=125.0
EQUITY_MODE_COMPOUNDING=true

# Parameter Biaya & Friction Pesimistis
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002

# Parameter Manajemen Risiko & Ukuran Posisi
ACCOUNT_LEVERAGE=8.0
RISK_PER_TRADE_PCT=0.015
MAX_CONCURRENT_SLOTS=2
MAX_SLOT_MARGIN_FRACTION=0.25
MAX_MARGIN_AVAIL_FRAC=0.90
MAX_DAILY_DRAWDOWN_PCT=-1.0

# Tipe Order Entry: "LIMIT" atau "MARKET"
ENTRY_ORDER_TYPE=LIMIT

# Parameter Dynamic Rolling Market Scanner (Setiap 15 Menit)
MIN_VOLUME_24H_USDT=25000000.0
MAX_SPREAD_PCT=0.05
MIN_FALLBACK_RVOL=0.60
MIN_NATR_PCT=0.85
MAX_NATR_PCT=1.80
MAX_SCANNER_VWAP_DIST_ATR=2.50
MAX_WATCHED_COINS=40

# Parameter Strategi VWAP Pullback / Retest with Orderflow Bounce (Model 2.5)
PULLBACK_TOLERANCE_ATR=0.30
MIN_BOUNCE_ZSCORE=0.85
MIN_BOUNCE_ZSCORE_LONG=1.25
MIN_BOUNCE_ZSCORE_SHORT=0.75
MIN_EMA200_DISTANCE_ATR=0.25
MAX_EMA200_DISTANCE_ATR=3.50
LOOKBACK_IMPULSE_BARS=18
RETEST_LOOKBACK_BARS=5
MIN_IMPULSE_ATR=0.75
MAX_ENTRY_DISTANCE_ATR=1.15

# Multiplier Stop Loss & Take Profit (ATR-based)
SL_ATR_MULTIPLIER=1.65
TP_ATR_MULTIPLIER=3.50
MIN_SL_DISTANCE_PCT=0.0100

# Partial Take Profit & Trailing Stop
PARTIAL_TP_ENABLED=true
PARTIAL_TP1_RATIO=0.40
PARTIAL_TP1_ATR_MULT=1.30
RUNNER_BE_CUSHION_ATR=0.0
TRAILING_ENABLED=true
TRAILING_ACTIVATE_ATR=1.60
TRAILING_DISTANCE_ATR=0.40

# Filter Makro BTC & Anti-Frenzy
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=0.60
BTC_MAX_5M_PUMP_PCT=0.60
BTC_GATE_PERSISTENCE_BARS=1
BTC_COUNTER_MOMENTUM_PCT=0.15
ALLOWED_SIDE=AUTO
MAX_FRENZY_RVOL=2.50
MIN_SIGNAL_RVOL=0.80

# Cooldown & Warmup Guard
COOLDOWN_AFTER_EXIT_MINUTES=20
COOLDOWN_AFTER_LOSS_MINUTES=60
COOLDOWN_AFTER_WIN_MINUTES=5
VWAP_SESSION_WARMUP_MINUTES=30
MAX_HOLDING_DURATION=4h
