# Market Breadth, Cooldown & Risk Throttles
MARKET_BREADTH_LOW_THRESHOLD=0.20
MARKET_BREADTH_LOW_RISK_MULT=0.40
DD_THROTTLE_THRESHOLD_PCT=0.20
DD_THROTTLE_RISK_MULT=0.55
MAX_NEW_ENTRIES_PER_BAR=0
PORTFOLIO_CLUSTER_SL_COUNT=3
PORTFOLIO_CLUSTER_COOLDOWN_MINUTES=90
COOLDOWN_AFTER_EXIT_MINUTES=30
COOLDOWN_AFTER_LOSS_MINUTES=90
COOLDOWN_AFTER_WIN_MINUTES=15
VWAP_SESSION_WARMUP_MINUTES=45

# Q-MAX Synthesis Overrides
MACRO_VOL_EXPANSION_RATIO=1.20
MACRO_VOL_EXPANSION_RISK_MULT=1.25
RS4H_WEAK_THRESHOLD_PCT=-2.0
RS4H_WEAK_RISK_MULT=1.25
RS4H_STRONG_THRESHOLD_PCT=2.0
RS4H_STRONG_RISK_MULT=0.50
BREAKOUT_RISK_MULT=1.25
MAX_EFFECTIVE_RISK_PER_TRADE_PCT=0.0323

# Pod #2 & Pod #3: Major 1h RS-Momentum (3POD_BAL — Balanced Growth & Risk)
MAJOR_RSMOM_SHORT_ENABLED=true
MAJOR_RSMOM_LONG_ENABLED=true
MAJOR_POD_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT,LTCUSDT,TRXUSDT,DOTUSDT,NEARUSDT,BCHUSDT
