# ==============================================================================
# TRML BINANCE USDⓈ-M FUTURES INTRADAY BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mode Lingkungan: "testnet" atau "mainnet"
BINANCE_ENV=mainnet

# Kredensial API Bursa Binance Futures (Wajib diisi jika DRY_RUN_MODE=false)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Mode Eksekusi: "true" untuk simulasi antrean volume-through-limit; "false" untuk order nyata
DRY_RUN_MODE=true

# Modal awal simulasi Dry-Run (USDT)
INITIAL_EQUITY=125.0

# Lokasi file database SQLite WAL
SQLITE_DB_PATH=./data/trml.db

# Level Logging: "DEBUG", "INFO", "WARN", "ERROR"
LOG_LEVEL=INFO

# Parameter Fee Sesuai Tier Akun (VIP 0 Default)
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002

# Parameter Risiko & Eksekusi
# Risiko per trade dalam desimal (0.015 = 1.5% dari total modal/equity)
RISK_PER_TRADE_PCT=0.015
# Batas Drawdown Harian (Circuit Breaker):
# "-1.0" (-100% / tanpa rem) untuk DRY-RUN agar menguji data 24 jam nonstop;
# Gunakan "-0.05" (-5%) jika DRY_RUN_MODE=false (live uang riil).
MAX_DAILY_DRAWDOWN_PCT=-1.0
MAX_CONCURRENT_SLOTS=3
MAX_SLOT_MARGIN_FRACTION=0.25
MAX_MARGIN_AVAIL_FRAC=0.90
ACCOUNT_LEVERAGE=8.0
RECV_WINDOW_MS=5000

# Tipe Order Entry: "MARKET" (disarankan untuk momentum/breakout/pullback agar tidak tertinggal) atau "LIMIT" (maker)
ENTRY_ORDER_TYPE=MARKET

# Parameter Market Scanner (Liquidity & Volatility Filtering)
MIN_VOLUME_24H_USDT=25000000.0
MIN_FALLBACK_RVOL=0.60
MAX_SPREAD_PCT=0.06
MIN_NATR_PCT=0.50
MAX_NATR_PCT=1.80
MAX_WATCHED_COINS=20
# Batas Maksimal Jarak Koin ke Session VWAP (ATR) saat scanning: eliminasi koin yang sudah terbang/anjlok jauh (> 2.5x ATR)
MAX_SCANNER_VWAP_DIST_ATR=2.50

# Parameter Strategi VWAP Pullback / Retest with Orderflow Bounce
PULLBACK_TOLERANCE_ATR=0.45
MIN_BOUNCE_ZSCORE=0.85
MIN_BOUNCE_ZSCORE_LONG=0.85
MIN_BOUNCE_ZSCORE_SHORT=0.85
MIN_EMA200_DISTANCE_ATR=0.15
MAX_EMA200_DISTANCE_ATR=4.00
LOOKBACK_IMPULSE_BARS=18
RETEST_LOOKBACK_BARS=5
MIN_IMPULSE_ATR=0.6
MAX_ENTRY_DISTANCE_ATR=1.15

# Parameter Derivatif & Open Interest (Sensitivitas 5-Menit)
# MIN_OI_DELTA_PCT bertindak sebagai fallback global jika LONG/SHORT tidak di-set
MIN_OI_DELTA_PCT=0.00
# Ambang batas spesifik arah (directional overrides)
MIN_OI_DELTA_LONG_PCT=0.02
MIN_OI_DELTA_SHORT_PCT=-0.02

# Multiplier Stop Loss & Take Profit (ATR-based)
# Standar altcoin intraday: SL 1.75x ATR, TP 4.50x ATR (Trailing runner)
SL_ATR_MULTIPLIER=1.75
TP_ATR_MULTIPLIER=4.50

# Stop Distance Floor: Menjamin jarak SL minimal 1.20% agar kebal terhadap noise acak 5m
MIN_SL_DISTANCE_PCT=0.012

# Partial Take Profit (Scale-Out: Amankan 50% Kas di TP1 + BE + 50% Runner ke Trailing)
PARTIAL_TP_ENABLED=true
PARTIAL_TP1_RATIO=0.50
PARTIAL_TP1_ATR_MULT=1.00
RUNNER_BE_CUSHION_ATR=0.00

# Trailing Stop untuk Runner (aktif pasca TP1 untuk menangkap ekspansi tren 3R, 4R, 5R tanpa batasan fixed TP2)
TRAILING_ENABLED=true
TRAILING_ACTIVATE_ATR=1.10
TRAILING_DISTANCE_ATR=0.55

# Parameter Trailing Break-Even & Profit Lock (Tiered Dynamic Multi-ATR)
# Tier 1 Rem Dini (Early BE Shield): Default false agar trade tidak tercekik di BE sebelum mencapai TP1
TIER1_BE_ENABLED=false
TIER1_BE_TRIGGER_LONG_ATR=0.75
TIER1_BE_TRIGGER_SHORT_ATR=0.80
# Tier 2 Runner Profit Lock: Memberi ruang napas pasca TP1, mengunci profit ke Entry +/- 0.75x ATR saat MFE mencapai 1.55x ATR
TIER2_PROFIT_LOCK_ATR=1.55
TIER2_PROFIT_LOCK_OFFSET_ATR=0.75
BREAK_EVEN_TRIGGER_ATR=1.15
# Batas Maksimal Holding Posisi (Time Stop Darurat - Default 4h / 48 bars 5m)
MAX_HOLDING_DURATION=4h
# Kebijakan Rekonsiliasi Posisi Orphan Mainnet saat Startup: "CLOSE" (Emergency Market Close jika tanpa SL aktif) atau "ADOPT"
ORPHAN_POSITION_POLICY=CLOSE

# Cooldown Pasca-Exit (Asymmetric Cooldown Architecture)
# - Loss / Break-Even: 20 menit (4 bar) untuk mencegah churn dan whipsaw berulang
# - Take Profit / Trailing: 5 menit (1 bar) jeda singkat cooling-down sebelum boleh menangkap second-leg
COOLDOWN_AFTER_EXIT_MINUTES=20
COOLDOWN_AFTER_LOSS_MINUTES=20
COOLDOWN_AFTER_WIN_MINUTES=5

# Session VWAP Warmup Guard (00:00 - 00:30 UTC): Tolak sinyal pullback saat volume sesi belum matang
VWAP_SESSION_WARMUP_MINUTES=30

# Gerbang Makro Bitcoin (Two-Tiered Soft Veto, Micro Counter-Momentum & Multi-Candle Persistence Buffer)
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=0.60
BTC_MAX_5M_PUMP_PCT=0.60
BTC_GATE_PERSISTENCE_BARS=3
BTC_COUNTER_MOMENTUM_PCT=0.25

# Filter Arah, Gatekeeper Volume & Anti-Frenzy (Proteksi Ledakan Pompaan Liar)
# ALLOWED_SIDE:
# - "AUTO" (Default Cerdas: Otomatis SHORT_ONLY jika BTC Bearish, LONG_ONLY jika BTC Bullish, BOTH jika Netral)
# - "BOTH" (Bypass filter arah tren makro BTC: izinkan LONG & SHORT kapan saja)
# - "SHORT_ONLY" (Kunci mati: hanya izinkan posisi SHORT)
# - "LONG_ONLY" (Kunci mati: hanya izinkan posisi LONG)
ALLOWED_SIDE=AUTO
MAX_FRENZY_RVOL=2.50
MAX_COUNTER_IMPULSE_ATR=1.50
MIN_SIGNAL_RVOL=0.75

# Port Web Dashboard & PWA (Cloudflare Tunnel Entrypoint)
HTTP_PORT=2020

# Keamanan Dashboard (PIN 6-Digit)
# Kosongkan ("") jika ingin mode open/bypass tanpa verifikasi PIN
DASHBOARD_PIN=

# Integrasi Google Gemini AI Copilot
# Dapatkan API Key di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=25
AI_RATE_LIMIT_RPM=10
