# ==============================================================================
# TRML BINANCE USDⓈ-M FUTURES INTRADAY BOT - QMAX_PAMUNGKAS ENVIRONMENT CONFIG
# ==============================================================================

# Mode Lingkungan: "testnet" atau "mainnet"
BINANCE_ENV=mainnet

# Timeframe Candlestick Utama & Scanner Interval
TIMEFRAME=15m
SCANNER_INTERVAL=30m

# Kredensial API Bursa Binance Futures (Wajib diisi jika DRY_RUN_MODE=false)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Mode Eksekusi: "true" untuk simulasi antrean volume-through-limit; "false" untuk order nyata
DRY_RUN_MODE=true

# Modal Awal & Mode Compounding
INITIAL_EQUITY=125.0
EQUITY_MODE_COMPOUNDING=true

# Lokasi file database SQLite WAL & Log Level
SQLITE_DB_PATH=./data/trml.db
LOG_LEVEL=INFO

# Parameter Fee & Friction Eksekusi
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002
FLAG_SL_GAP_FILL=true
FLAG_DEDUCT_PENDING_MARGIN=true

# Parameter Risiko & Ukuran Posisi (QMAX_PAMUNGKAS)
RISK_PER_TRADE_PCT=0.0250
# Batas Drawdown Harian: -0.075 (-7.5%) untuk LIVE; bisa dinaikkan di DRY-RUN bila perlu uji nonstop
MAX_DAILY_DRAWDOWN_PCT=-0.075
MAX_CONCURRENT_SLOTS=6
MAX_SLOT_MARGIN_FRACTION=0.22
MAX_MARGIN_AVAIL_FRAC=0.90
ACCOUNT_LEVERAGE=10.0
RECV_WINDOW_MS=5000

# Tipe Order Entry: "LIMIT" atau "MARKET"
ENTRY_ORDER_TYPE=LIMIT
LIMIT_ORDER_TIMEOUT=15m
ENTRY_REPEG_MAX_ATTEMPTS=0
ENTRY_REPEG_MAX_DRIFT_PCT=0.0005

# Parameter Market Scanner (Liquidity & Volatility Filtering)
MIN_VOLUME_24H_USDT=15000000.0
MIN_FALLBACK_RVOL=0.50
MAX_SPREAD_PCT=0.11
MIN_NATR_PCT=0.95
MAX_NATR_PCT=1.60
MAX_WATCHED_COINS=100
MAX_SCANNER_VWAP_DIST_ATR=2.50
SCANNER_RANKING_MODE=pullback
SCANNER_EXCLUDE_TOP_VOL_RANK=15

# Strategi 1: VWAP Pullback / Retest with Orderflow Bounce
VWAP_STRATEGY_ENABLED=true
PULLBACK_TOLERANCE_ATR=0.38
MIN_BOUNCE_ZSCORE=0.65
MIN_BOUNCE_ZSCORE_LONG=0.60
MIN_BOUNCE_ZSCORE_SHORT=0.70
MIN_EMA200_DISTANCE_ATR=0.20
MAX_EMA200_DISTANCE_ATR=3.80
LOOKBACK_IMPULSE_BARS=12
RETEST_LOOKBACK_BARS=4
MIN_IMPULSE_ATR=0.75
MAX_ENTRY_DISTANCE_ATR=1.20

# Strategi 2: Vol Compression Donchian Breakout (Prioritas #1 di Trend Regime)
BREAKOUT_STRATEGY_ENABLED=true
BREAKOUT_PRIORITY_FIRST=true
BREAKOUT_LOOKBACK_BARS=16
BREAKOUT_MAX_COMPRESSION=0.90
BREAKOUT_MIN_RVOL=1.40
BREAKOUT_MIN_BODY_RATIO=0.45
BREAKOUT_MIN_DELTA_Z=0.50

# Strategi Lain (Disabled)
SWEEP_STRATEGY_ENABLED=false
SWEEP_LOOKBACK_BARS=12
SWEEP_MIN_UPPER_WICK_RATIO=0.25
SWEEP_MAX_LOWER_WICK_RATIO=0.45
SWEEP_MAX_DELTA_ZSCORE=-0.25
SWEEP_SCANNER_ALLOW_EXTENDED_VWAP=false
SWEEP_SCANNER_MAX_EXTRA_COINS=15
REL_STRATEGY_ENABLED=false

# Parameter Derivatif & Open Interest (DISABLE_OI_FILTER=true mengikuti preset QMAX_PAMUNGKAS)
DISABLE_OI_FILTER=true
MIN_OI_DELTA_PCT=0.00
MIN_OI_DELTA_LONG_PCT=-0.50
MIN_OI_DELTA_SHORT_PCT=-1.00

# Exit Ladder, Time Stop & Stale-Loss Cut
SL_ATR_MULTIPLIER=2.00
TP_ATR_MULTIPLIER=5.00
MIN_SL_DISTANCE_PCT=0.0150
PARTIAL_TP_ENABLED=false
PARTIAL_TP1_RATIO=0.35
PARTIAL_TP1_ATR_MULT=1.25
RUNNER_BE_CUSHION_ATR=0.00
TRAILING_ENABLED=true
TRAILING_ACTIVATE_ATR=2.50
TRAILING_DISTANCE_ATR=1.00
TIER1_BE_ENABLED=false
TIER1_BE_TRIGGER_LONG_ATR=1.05
TIER1_BE_TRIGGER_SHORT_ATR=0.85
TIER2_PROFIT_LOCK_ENABLED=false
BREAK_EVEN_TRIGGER_ATR=1.15
STALE_LOSS_EXIT_DURATION=6h
MAX_HOLDING_DURATION=18h
ORPHAN_POSITION_POLICY=CLOSE

# Cooldown & Session VWAP Warmup Guard
COOLDOWN_AFTER_EXIT_MINUTES=30
COOLDOWN_AFTER_LOSS_MINUTES=90
COOLDOWN_AFTER_WIN_MINUTES=15
VWAP_SESSION_WARMUP_MINUTES=45

# Filter Makro BTC, HTF 1h EMA200 & Multi-Regime Router
ALLOWED_SIDE=SHORT_ONLY
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=1.15
BTC_MAX_5M_PUMP_PCT=1.15
BTC_GATE_PERSISTENCE_BARS=1
FLAG_BTC_GATE_SHORT_ONLY=true
BTC_COUNTER_MOMENTUM_PCT=0.30
MAX_FRENZY_RVOL=2.50
MAX_COUNTER_IMPULSE_ATR=1.50
MIN_SIGNAL_RVOL=0.0
MIN_EMA_SLOPE_LONG=0.008
MIN_CANDLE_BODY_RATIO_LONG=0.25
MIN_NATR_LONG_PCT=1.05
BTC_CHOP_BLOCK_LONG=true
BTC_CHOP_BLOCK_SHORT=true
BTC_CHOP_RISK_MULT=1.0
DISABLE_PANIC_DUMP_FRENZY_LONG=true
BTC_TIER2_LONG_SYMMETRIC=false
BLOCKED_UTC_HOURS=
MACRO_REGIME_ROUTER_ENABLED=true
MACRO_TREND_ER_THRESHOLD=0.30
MACRO_VOL_SHOCK_RATIO=1.50
MACRO_VWAP_ONLY_IN_RANGE=false
MACRO_BREAKOUT_ONLY_IN_TREND=true
MACRO_REL_ONLY_IN_RANGE=false
MACRO_RANGE_RISK_MULT=0.45
MIN_SHORT_FUNDING_RATE=-0.0002
HTF_EMA_PERIOD=200
HTF_EMA_MAX_RISING_SLOPE_PCT=0.20

# Market Breadth, Cluster SL Guard & Q-MAX Risk Factors
MARKET_BREADTH_LOW_THRESHOLD=0.20
MARKET_BREADTH_LOW_RISK_MULT=0.40
DD_THROTTLE_THRESHOLD_PCT=0.20
DD_THROTTLE_RISK_MULT=0.55
RESET_PEAK_EQUITY_ON_BOOT=false
MAX_NEW_ENTRIES_PER_BAR=0
PORTFOLIO_CLUSTER_SL_COUNT=3
PORTFOLIO_CLUSTER_COOLDOWN_MINUTES=90
MACRO_VOL_EXPANSION_RATIO=1.20
MACRO_VOL_EXPANSION_RISK_MULT=1.25
RS4H_WEAK_THRESHOLD_PCT=-2.0
RS4H_WEAK_RISK_MULT=1.25
RS4H_STRONG_THRESHOLD_PCT=2.0
RS4H_STRONG_RISK_MULT=0.50
BREAKOUT_RISK_MULT=1.25
MAX_EFFECTIVE_RISK_PER_TRADE_PCT=0.038

# Port Web Dashboard & PWA
HTTP_PORT=2020
DASHBOARD_PIN=

# Integrasi Google Gemini AI Copilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=25
AI_RATE_LIMIT_RPM=10
