# ==============================================================================
# TRML BINANCE USDⓈ-M FUTURES INTRADAY BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mode Lingkungan: "testnet" atau "mainnet"
BINANCE_ENV=mainnet

# Kredensial API Bursa Binance Futures (Wajib diisi jika DRY_RUN_MODE=false)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Mode Eksekusi: "true" untuk simulasi antrean volume-through-limit; "false" untuk order nyata
DRY_RUN_MODE=true

# Modal awal simulasi Dry-Run (USDT)
INITIAL_EQUITY=125.0

# Lokasi file database SQLite WAL
SQLITE_DB_PATH=./data/trml.db

# Level Logging: "DEBUG", "INFO", "WARN", "ERROR"
LOG_LEVEL=INFO

# Parameter Fee Sesuai Tier Akun (VIP 0 Default)
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002

# Parameter Risiko & Eksekusi
# Risiko per trade dalam desimal (0.015 = 1.5% dari total modal/equity)
RISK_PER_TRADE_PCT=0.015
# Batas Drawdown Harian (Circuit Breaker):
# "-1.0" (-100% / tanpa rem) untuk DRY-RUN agar menguji data 24 jam nonstop;
# Gunakan "-0.05" (-5%) jika DRY_RUN_MODE=false (live uang riil).
MAX_DAILY_DRAWDOWN_PCT=-1.0
MAX_CONCURRENT_SLOTS=3
MAX_SLOT_MARGIN_FRACTION=0.30
MAX_MARGIN_AVAIL_FRAC=0.90
ACCOUNT_LEVERAGE=8.0
RECV_WINDOW_MS=5000

# Tipe Order Entry: "MARKET" (disarankan untuk momentum/breakout/pullback agar tidak tertinggal) atau "LIMIT" (maker)
ENTRY_ORDER_TYPE=MARKET

# Parameter Market Scanner (Liquidity & Volatility Filtering)
MIN_VOLUME_24H_USDT=50000000.0
MIN_FALLBACK_RVOL=0.50
MAX_SPREAD_PCT=0.05
MIN_NATR_PCT=0.35
MAX_NATR_PCT=2.50
MAX_WATCHED_COINS=20

# Parameter Strategi VWAP Pullback / Retest with Orderflow Bounce
PULLBACK_TOLERANCE_ATR=0.45
MIN_BOUNCE_ZSCORE=1.20
LOOKBACK_IMPULSE_BARS=18
RETEST_LOOKBACK_BARS=5
MIN_IMPULSE_ATR=1.0
MAX_ENTRY_DISTANCE_ATR=0.60

# Parameter Derivatif & Open Interest (Sensitivitas 5-Menit)
# MIN_OI_DELTA_PCT bertindak sebagai fallback global jika LONG/SHORT tidak di-set
MIN_OI_DELTA_PCT=0.05
# Ambang batas spesifik arah (directional overrides)
MIN_OI_DELTA_LONG_PCT=0.05
MIN_OI_DELTA_SHORT_PCT=-0.02

# Multiplier Stop Loss & Take Profit (ATR-based)
# Standar altcoin intraday: SL 1.5x ATR, TP 2.25x ATR (Risk:Reward = 1:1.5)
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=2.25

# Parameter Trailing Break-Even (ATR-based)
# Dipicu jika floating profit mencapai 1.15x ATR (51% jarak menuju TP 2.25x ATR)
BREAK_EVEN_TRIGGER_ATR=1.15

# Gerbang Makro Bitcoin (Two-Tiered Soft Veto)
BTC_GATE_ENABLED=true
BTC_MAX_5M_DUMP_PCT=0.60
BTC_MAX_5M_PUMP_PCT=0.60

# Filter Arah & Anti-Frenzy (Proteksi Ledakan Pompaan Liar)
# ALLOWED_SIDE:
# - "AUTO" (Default Cerdas: Otomatis SHORT_ONLY jika BTC Bearish, LONG_ONLY jika BTC Bullish, BOTH jika Netral)
# - "BOTH" (Bypass filter arah tren makro BTC: izinkan LONG & SHORT kapan saja)
# - "SHORT_ONLY" (Kunci mati: hanya izinkan posisi SHORT)
# - "LONG_ONLY" (Kunci mati: hanya izinkan posisi LONG)
ALLOWED_SIDE=AUTO
MAX_FRENZY_RVOL=2.50
MAX_COUNTER_IMPULSE_ATR=1.50

# Port Web Dashboard & PWA (Cloudflare Tunnel Entrypoint)
HTTP_PORT=2020

# Keamanan Dashboard (PIN 6-Digit)
# Kosongkan ("") jika ingin mode open/bypass tanpa verifikasi PIN
DASHBOARD_PIN=

# Integrasi Google Gemini AI Copilot
# Dapatkan API Key di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=25
AI_RATE_LIMIT_RPM=10
